                  "padding-bottom": "1rem"
                }
              },
              "& when not (@reverseContent) and (@fullWidth)": {
                ".image-element": {
                  "padding-top": "1rem"
                }
              },
              "& when (@reverseContent)": {
                ".row": {
                  "-webkit-flex-direction": "column-reverse",
                  "flex-direction": "column-reverse"
                }
              },
              "& when not (@fullWidth)": {
                "& when (@reverseContent)": {
                  ".text-element": {
                    "padding-top": "0"
                  }
                },
                "& when not (@reverseContent)": {
                  ".text-element": {
                    "padding-bottom": "0"
                  }
                }
              },
              ".paragraphs-wrapper": {
                "-webkit-flex-direction": "column",
                "flex-direction": "column",
                ".first-paragraph, .second-paragraph": {
                  "width": "100%",
                  "padding": "0"
                }
              }
            },
            "@media (min-width: 768px)": {
              ".first-paragraph, .second-paragraph": {
                "width": "50%"
              },
              ".first-paragraph": {
                "padding-right": "0.5rem"
              },
              ".second-paragraph": {
