      "settings": {
        "title": "Area&amp;Activities",
        "meta_descr": "Celini Retreat Vacation Rentals in Naxos for relaxed holidays in Cyclades in Greece",
        "header_custom": "<meta name=\"google-site-verification\" content=\"uTGNo3kOaaIU3aKMh2UvrBENp_sFuVoZvBylpkQeH5o\" />",
        "footer_custom": "",
