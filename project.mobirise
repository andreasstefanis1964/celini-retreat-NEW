        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 40px",
                "@media (max-width: 992px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 768px)": {
                "min-width": "100%",
                "max-width": "100%",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important",
                "border-right": "none"
              },
              ".card-wrap": {
                "display": "flex",
                "@media (max-width: 992px)": {
                  "display": "block"
                },
                ".content-wrap": {
                  "width": "40%",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "24px",
                    "width": "100%"
                  },
                  ".card-subtitle": {
                    "margin-bottom": "10px",
                    "letter-spacing": ".16em"
                  },
                  ".card-title": {
                    "margin-bottom": "16px"
                  },
                  ".card-desc": {
                    "margin-bottom": "30px"
                  },
                  ".card-text": {
                    "margin-bottom": "24px"
                  }
                },
                ".item-wrapper": {
                  "width": "60%",
                  "padding-left": "4rem",
                  "& when (@reverseContent)": {
                    "padding-left": "0",
                    "padding-right": "4rem",
                    "@media (max-width: 992px)": {
                      "padding": "0"
                    }
                  },
                  "@media (max-width: 992px)": {
                    "width": "100%",
                    "padding": "0"
                  },
                  ".image-wrap": {
                    "height": "100%",
                    "display": "flex",
                    "align-items": "center",
                    "img": {
                      "height": "650px",
                      "width": "100%",
                      "object-fit": "cover",
                      "@media (max-width: 992px)": {
                        "height": "550px"
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "-3rem",
              "width": "40px",
              "height": "40px",
              "margin-top": "-1.5rem",
              "font-size": "16px",
              "background-color": "transparent",
              "color": "@primaryColor",
              "border": "2px solid @infoColor",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "background": "transparent",
                "color": "@primaryColor",
                "border-color": "@primaryColor"
              },
              "&.embla__button--prev": {
                "left": "auto",
                "right": "3.5rem",
                "margin-left": "0"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".card-subtitle": {
              "color": "#ededed"
            },
            ".card-title": {
              "color": "#2e8ba9"
            },
            ".card-desc": {
              "color": "#ffffff"
            },
            ".card-text": {
              "color": "#2e8ba9"
            }
          },
          "_name": "slider2",
          "_sourceTheme": "electricm5",
          "_customHTML": "<section class=\"slider2 mbr-embla electricm5\" group=\"Sliders & Galleries\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"embla\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"8\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/electricm5/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#c6ad72\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/electricm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row position-relative\">\n            <div class=\"col-12\">\n                <div class=\"slider-wrap\">\n                    <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                        <div class=\"embla__viewport\">\n                            <div class=\"embla__container\">\n                                <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"card-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                        <div class=\"content-wrap\">\n                                            <h5 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                    \n                                            </h5>\n                                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                                <br><br>Double rooms</h4>\n                                            <p class=\"card-desc mbr-fonts-style\" data-app-selector=\".card-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">from € 59,00*/unit &amp; night (*non refundable rate Low season)<br></p>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Your perfect stay begins with the right space. Cozy and inviting, perfect for couples or solo travelers.</p>\n                                            <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mbri-wifi mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a>\n                                                <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v1-air-conditioner1 mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v3-smart-tv mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v4-kitchen-sink mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a>  <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"imind-coffee-machine mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v1-hairdryer mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v3-showerheads-01 mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a>   <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"imind-broom mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a>   <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v4-house-plan mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span>20m²</a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mdi-social-people mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span>max</a>  <a class=\"btn btn-info\" data-app-placeholder=\"Type Text\" href=\"https://book.roompanda.com/c/celini-retreat-naxos-double-rooms\" target=\"_blank\"><span class=\"fa fa-calendar mbr-iconfont mbr-iconfont-btn\"></span>BOOK ONLINE</a> <a class=\"btn btn-primary-outline\" data-app-placeholder=\"Type Text\" href=\"page3.html#slider01-6n\" target=\"_blank\"><span class=\"fa fa-info-circle mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(255, 255, 255);\"></span>&gt;&gt; MORE INFO</a></div>\n                                        </div>\n                                        <div class=\"item-wrapper position-relative\">\n                                            <div class=\"image-wrap\">\n                                                \n                                            <a href=\"page3.html#slider01-6n\" target=\"false\"><img src=\"@PROJECT_PATH@/assets/images/-35a5515-hdr.webp\" alt data-slide-to=\"0\" data-bs-slide-to=\"0\"></a></div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"card-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                        <div class=\"content-wrap\">\n                                            <h5 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                    \n                                            </h5>\n                                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                                <br><br><a href=\"page3.html#slider01-6n\" class=\"text-info\">Double rooms</a></h4>\n                                            <p class=\"card-desc mbr-fonts-style\" data-app-selector=\".card-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">from € 59,00*/unit &amp; night (*non refundable rate Low season)<br></p>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Your perfect stay begins with the right space. Cozy and inviting, perfect for couples or solo travelers.</p>\n                                            <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mbri-wifi mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a>\n                                                <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v1-air-conditioner1 mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v3-smart-tv mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v4-kitchen-sink mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a>  <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"imind-coffee-machine mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v1-hairdryer mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v3-showerheads-01 mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a>   <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"imind-broom mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a>   <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v4-house-plan mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span>20m²</a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mdi-social-people mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span>max</a>  <a class=\"btn btn-info\" data-app-placeholder=\"Type Text\" href=\"https://book.roompanda.com/celininaxos\" target=\"_blank\"><span class=\"fa fa-calendar mbr-iconfont mbr-iconfont-btn\"></span>BOOK ONLINE</a> <a class=\"btn btn-primary-outline\" data-app-placeholder=\"Type Text\" href=\"page3.html#slider01-6n\" target=\"_blank\"><span class=\"fa fa-info-circle mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(255, 255, 255);\"></span>&gt;&gt; MORE INFO</a></div>\n                                        </div>\n                                        <div class=\"item-wrapper position-relative\">\n                                            <div class=\"image-wrap\">\n                                                \n                                            <a href=\"page3.html#slider01-6n\" target=\"false\"><img src=\"@PROJECT_PATH@/assets/images/-35a5515-hdr.webp\" alt data-slide-to=\"1\" data-bs-slide-to=\"1\"></a></div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"card-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                        <div class=\"content-wrap\">\n                                            <h5 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                    \n                                            </h5>\n                                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                                <br><br>Double rooms</h4>\n                                            <p class=\"card-desc mbr-fonts-style\" data-app-selector=\".card-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">from € 59,00*/unit &amp; night (*non refundable rate Low season)<br></p>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Your perfect stay begins with the right space. Cozy and inviting, perfect for couples or solo travelers.</p>\n                                            <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mbri-wifi mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a>\n                                               <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v1-air-conditioner1 mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v3-smart-tv mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v4-kitchen-sink mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a>  <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"imind-coffee-machine mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v1-hairdryer mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v3-showerheads-01 mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a>   <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"imind-broom mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span></a>   <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v4-house-plan mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span>20m²</a> <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mdi-social-people mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px;\"></span>max</a>  <a class=\"btn btn-info\" data-app-placeholder=\"Type Text\" href=\"https://book.roompanda.com/c/celini-retreat-naxos-double-rooms\" target=\"_blank\"><span class=\"fa fa-calendar mbr-iconfont mbr-iconfont-btn\"></span>BOOK ONLINE</a> <a class=\"btn btn-primary-outline\" data-app-placeholder=\"Type Text\" href=\"page3.html#slider01-6n\" target=\"_blank\"><span class=\"fa fa-info-circle mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(255, 255, 255);\"></span>&gt;&gt; MORE INFO</a></div>\n                                        </div>\n                                        <div class=\"item-wrapper position-relative\">\n                                            <div class=\"image-wrap\">\n                                                \n                                            <a href=\"page3.html#slider01-6n\" target=\"false\"></a><a href=\"page3.html#slider01-6n\" target=\"false\"><img src=\"@PROJECT_PATH@/assets/images/-35a5530-hdr.webp\" alt data-slide-to=\"2\" data-bs-slide-to=\"3\"></a></div>\n                                        </div>\n                                    </div>\n                                </div>\n                                \n                            </div>\n                        </div>\n                        <button class=\"embla__button embla__button--prev\">\n                            <span class=\"mbr-iconfont mobi-mbri-left mobi-mbri\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden\">Previous</span>\n                        </button>\n                        <button class=\"embla__button embla__button--next\">\n                            <span class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden\">Next</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uGMavXzUVU",
          "_anchor": "slider2-66",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 40px",
                "@media (max-width: 992px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 768px)": {
                "min-width": "100%",
                "max-width": "100%",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important",
                "border-right": "none"
              },
              ".card-wrap": {
                "display": "flex",
                "@media (max-width: 992px)": {
                  "display": "block"
                },
                ".content-wrap": {
                  "width": "40%",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "24px",
                    "width": "100%"
                  },
                  ".card-subtitle": {
                    "margin-bottom": "10px",
                    "letter-spacing": ".16em"
                  },
                  ".card-title": {
                    "margin-bottom": "16px"
                  },
                  ".card-desc": {
                    "margin-bottom": "30px"
                  },
                  ".card-text": {
                    "margin-bottom": "24px"
                  }
                },
                ".item-wrapper": {
                  "width": "60%",
                  "padding-left": "4rem",
                  "& when (@reverseContent)": {
                    "padding-left": "0",
                    "padding-right": "4rem",
                    "@media (max-width: 992px)": {
                      "padding": "0"
                    }
                  },
                  "@media (max-width: 992px)": {
                    "width": "100%",
                    "padding": "0"
                  },
                  ".image-wrap": {
                    "height": "100%",
                    "display": "flex",
                    "align-items": "center",
                    "img": {
                      "height": "650px",
                      "width": "100%",
                      "object-fit": "cover",
                      "@media (max-width: 992px)": {
                        "height": "550px"
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "-3rem",
              "width": "40px",
              "height": "40px",
              "margin-top": "-1.5rem",
              "font-size": "16px",
              "background-color": "transparent",
              "color": "@primaryColor",
              "border": "2px solid @infoColor",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "background": "transparent",
                "color": "@primaryColor",
                "border-color": "@primaryColor"
              },
              "&.embla__button--prev": {
                "left": "auto",
                "right": "3.5rem",
                "margin-left": "0"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".card-subtitle": {
              "color": "#ededed"
            },
            ".card-title": {
              "color": "#a3c6d2"
            },
            ".card-desc": {
              "color": "#ffffff"
            },
            ".card-text": {
              "color": "#a3c6d2"
            }
          },
          "_name": "slider2",
          "_sourceTheme": "electricm5",
          "_customHTML": "<section class=\"slider2 mbr-embla electricm5\" group=\"Sliders & Galleries\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"embla\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"8\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/electricm5/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#a2784f\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/electricm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row position-relative\">\n            <div class=\"col-12\">\n                <div class=\"slider-wrap\">\n                    <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                        <div class=\"embla__viewport\">\n                            <div class=\"embla__container\">\n                                <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"card-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                        <div class=\"content-wrap\">\n                                            <h5 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                    \n                                            </h5>\n                                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                                <br><br>Triple rooms</h4>\n                                            <p class=\"card-desc mbr-fonts-style\" data-app-selector=\".card-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">from € 72,00*/unit &amp; night (*non refundable rate Low season)<br></p>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Your perfect stay begins with the right space. Ideal for small families or groups of friends looking for extra space.&nbsp;</p>\n                                            <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mbri-wifi mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a>\n                                               <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v1-air-conditioner1 mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a> <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v3-smart-tv mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a> <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v4-kitchen-sink mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a>  <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"imind-coffee-machine mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a> <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v1-hairdryer mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a> <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v3-showerheads-01 mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a>   <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"imind-broom mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a>    <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v4-house-plan mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span>22m²</a> <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"imind-myspace mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span>max</a>  <a class=\"btn btn-info\" data-app-placeholder=\"Type Text\" href=\"https://book.roompanda.com/celininaxos\" target=\"_blank\"><span class=\"fa fa-calendar mbr-iconfont mbr-iconfont-btn\"></span>BOOK ONLINE</a> <a class=\"btn btn-warning-outline\" data-app-placeholder=\"Type Text\" href=\"page4.html#slider01-74\" target=\"_blank\"><span class=\"fa fa-info-circle mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span>&gt;&gt; MORE INFO</a></div>\n                                        </div>\n                                        <div class=\"item-wrapper position-relative\">\n                                            <div class=\"image-wrap\">\n                                                \n                                            <a href=\"page4.html#slider01-74\" target=\"false\"><img src=\"@PROJECT_PATH@/assets/images/studios-104.webp\" alt data-slide-to=\"1\" data-bs-slide-to=\"2\"></a></div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"card-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                        <div class=\"content-wrap\">\n                                            <h5 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                    \n                                            </h5>\n                                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                                <br><br>Triple rooms</h4>\n                                            <p class=\"card-desc mbr-fonts-style\" data-app-selector=\".card-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">from € 72,00*/unit &amp; night (*non refundable rate Low season)<br></p>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Your perfect stay begins with the right space. Ideal for small families or groups of friends looking for extra space.&nbsp;</p>\n                                            <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mbri-wifi mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a>\n                                                <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v1-air-conditioner1 mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a> <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v3-smart-tv mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a> <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v4-kitchen-sink mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a>  <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"imind-coffee-machine mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a> <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v1-hairdryer mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a> <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v3-showerheads-01 mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a>   <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"imind-broom mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span></a>    <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v4-house-plan mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span>22m²</a> <a class=\"btn btn-warning-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"imind-myspace mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span>max</a>  <a class=\"btn btn-info\" data-app-placeholder=\"Type Text\" href=\"https://book.roompanda.com/c/celini-retreat-naxos-triple-rooms\" target=\"_blank\"><span class=\"fa fa-calendar mbr-iconfont mbr-iconfont-btn\"></span>BOOK ONLINE</a> <a class=\"btn btn-warning-outline\" data-app-placeholder=\"Type Text\" href=\"page4.html#slider01-74\" target=\"_blank\"><span class=\"fa fa-info-circle mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span>&gt;&gt; MORE INFO</a></div>\n                                        </div>\n                                        <div class=\"item-wrapper position-relative\">\n                                            <div class=\"image-wrap\">\n                                                \n                                            <a href=\"page4.html#slider01-74\" target=\"false\"><img src=\"@PROJECT_PATH@/assets/images/studios-95.webp\" alt data-slide-to=\"2\" data-bs-slide-to=\"3\"></a></div>\n                                        </div>\n                                    </div>\n                                </div>\n                                \n                            </div>\n                        </div>\n                        <button class=\"embla__button embla__button--prev\">\n                            <span class=\"mbr-iconfont mobi-mbri-left mobi-mbri\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden\">Previous</span>\n                        </button>\n                        <button class=\"embla__button embla__button--next\">\n                            <span class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden\">Next</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_anchor": "slider2-6c",
          "_cid": "uGMKKpmNGK",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 40px",
                "@media (max-width: 992px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 768px)": {
                "min-width": "100%",
                "max-width": "100%",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important",
                "border-right": "none"
              },
              ".card-wrap": {
                "display": "flex",
                "@media (max-width: 992px)": {
                  "display": "block"
                },
                ".content-wrap": {
                  "width": "40%",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "24px",
                    "width": "100%"
                  },
                  ".card-subtitle": {
                    "margin-bottom": "10px",
                    "letter-spacing": ".16em"
                  },
                  ".card-title": {
                    "margin-bottom": "16px"
                  },
                  ".card-desc": {
                    "margin-bottom": "30px"
                  },
                  ".card-text": {
                    "margin-bottom": "24px"
                  }
                },
                ".item-wrapper": {
                  "width": "60%",
                  "padding-left": "4rem",
                  "& when (@reverseContent)": {
                    "padding-left": "0",
                    "padding-right": "4rem",
                    "@media (max-width: 992px)": {
                      "padding": "0"
                    }
                  },
                  "@media (max-width: 992px)": {
                    "width": "100%",
                    "padding": "0"
                  },
                  ".image-wrap": {
                    "height": "100%",
                    "display": "flex",
                    "align-items": "center",
                    "img": {
                      "height": "650px",
                      "width": "100%",
                      "object-fit": "cover",
                      "@media (max-width: 992px)": {
                        "height": "550px"
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "-3rem",
              "width": "40px",
              "height": "40px",
              "margin-top": "-1.5rem",
              "font-size": "16px",
              "background-color": "transparent",
              "color": "@primaryColor",
              "border": "2px solid @infoColor",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "background": "transparent",
                "color": "@primaryColor",
                "border-color": "@primaryColor"
              },
              "&.embla__button--prev": {
                "left": "auto",
                "right": "3.5rem",
                "margin-left": "0"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".card-subtitle": {
              "color": "#ededed"
            },
            ".card-title": {
              "color": "#c6ad72"
            },
            ".card-desc": {
              "color": "#ffffff"
            },
            ".card-text": {
              "color": "#c6ad72"
            }
          },
          "_name": "slider2",
          "_sourceTheme": "electricm5",
          "_customHTML": "<section class=\"slider2 mbr-embla electricm5\" group=\"Sliders & Galleries\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"embla\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"8\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/electricm5/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#487f91\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/electricm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row position-relative\">\n            <div class=\"col-12\">\n                <div class=\"slider-wrap\">\n                    <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                        <div class=\"embla__viewport\">\n                            <div class=\"embla__container\">\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"card-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                                        <div class=\"content-wrap\">\n                                            <h5 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                    \n                                            </h5>\n                                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                                <br><br>Two bedroom apartment</h4>\n                                            <p class=\"card-desc mbr-fonts-style\" data-app-selector=\".card-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">from € 78,00*/unit &amp; night (*non refundable rate Low season)<br></p>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">A spacious haven with room for everyone, offering added privacy and comfort, designed for families or small groups seeking a relaxing getaway.&nbsp;</p>\n                                            <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mbri-wifi mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(198, 173, 114);\"></span></a>\n                                                <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v1-air-conditioner1 mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(198, 173, 114);\"></span></a> <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v3-smart-tv mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(198, 173, 114);\"></span></a> <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-ap