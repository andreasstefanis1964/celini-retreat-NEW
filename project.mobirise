          "_name": "features3",
          "_sourceTheme": "hotelm4",
          "_customHTML": "<section class=\"features3 hotelm4_features3\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\" condition=\"!fullWidth\">\n\t\t<input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\" condition=\"!fullWidth\">\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n\t\t<input type=\"range\" inline=\"\" title=\"Media Size\" name=\"mediaSize\" min=\"20\" max=\"100\" step=\"5\" value=\"100\" condition=\"!fullWidth\">\n\t\t<select title=\"Paragraphs Count\" name=\"paragraphsCount\" condition=\"showText\">\n\t\t\t<option value=\"1\" selected=\"\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t</select>\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked=\"\">\n\t\t<input type=\"checkbox\" title=\"Underline\" name=\"showUnderline\" condition=\"showSubtitle\" checked=\"\">\n\t\t<input type=\"color\" title=\"Underline Color\" name=\"underlineColor\" value=\"#ffffff\" condition=\"showUnderline &amp;&amp; showSubtitle\">\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n\t\t<input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n\t\t<input type=\"checkbox\" title=\"Media on Left/Right\" name=\"reverseContent\" checked=\"\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax=\"\">\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\" parallax=\"\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#a2784f\" selected=\"\">\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=2jqUN6d6ZyM\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked=\"\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n\t\t<input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div mbr-class=\"{'container-fluid': fullWidth,\n                    'container': !fullWidth}\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"image-element\" mbr-class=\"{'col-xl-5': !fullWidth,\n                            'col-xl-6': fullWidth}\">\n\t\t\t\t<div class=\"img-wrap\" mbr-style=\"{'height': mediaSize + '%',\n                                'width': mediaSize + '%'}\">\n\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/mbr-1919x1279.webp\" alt=\"\">\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"text-element\" mbr-class=\"{'col-xl-5': !fullWidth,\n                            'col-xl-6': fullWidth}\" mbr-if=\"showTitle || showSubtitle || showText ||showButtons\">\n\t\t\t\t<h3 class=\"mbr-section-subtitle mbr-fonts-style mbr-lighter mbr-white\" mbr-class=\"{'pb-3': !showUnderline}\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle, .underline\">CELINI RETREAT IN NAXOS ISLAND</h3>\n\t\t\t\t<div class=\"underline pb-3\" mbr-if=\"showUnderline &amp;&amp; showSubtitle\">\n\t\t\t\t\t<div class=\"line\"></div>\n\t\t\t\t</div>\n\t\t\t\t<h2 class=\"mbr-section-title mbr-fonts-style pb-4 mbr-white\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Naxos Chora<br></h2>\n\t\t\t\t<div class=\"paragraphs-wrapper pb-4\" mbr-if=\"showText\">\n\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-lighter\" mbr-class=\"{'first-paragraph': paragraphsCount == 2}\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">Naxos Chora, the capital of Naxos Island in the Cyclades, is a charming destination with a blend of historical, cultural, and natural attractions. Here’s what’s good to know:<br><br>1. Portara (Temple of Apollo): The most iconic landmark in Naxos Chora<br>2. Venetian Castle (Kastro), a medieval Venetian castle, dominates the town.<br>3. Charming Old Town (Old Market): The labyrinthine streets of the Old Town are perfect for wandering. <br>4. Naxos Chora is close to beautiful beaches, such as Agios Georgios, just a short walk from the town. <br>5. Cultural and Historical Significance</p>\n\t\t\t\t\t<p class=\"second-paragraph mbr-text mbr-fonts-style mbr-lighter\" mbr-theme-style=\"display-7\" mbr-if=\"paragraphsCount == 2\" data-app-selector=\".mbr-text, .mbr-section-btn\">with fridge and stovetop, and a bathroom with bath or shower. Facilities also include a mini safe, a flat-screen TV and free WiFi. Enjoy the fresh sea breeze with your morning coffee in your private balcony. </p>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"mbr-section-btn\" mbr-buttons=\"\" data-toolbar=\"-mbrBtnMove\" mbr-if=\"showButtons\" mbr-theme-style=\"display-4\"><a class=\"btn btn-lg btn-info\" data-app-placeholder=\"Type Text\">MORE INFORMATION</a></div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
